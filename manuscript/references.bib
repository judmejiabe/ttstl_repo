@article{LI2024106099,
title = {Z-valued time series: Models, properties and comparison},
journal = {Journal of Statistical Planning and Inference},
volume = {230},
pages = {106099},
year = {2024},
issn = {0378-3758},
doi = {https://doi.org/10.1016/j.jspi.2023.106099},
url = {https://www.sciencedirect.com/science/article/pii/S037837582300068X},
author = {Qi Li and Huaping Chen and Fukang Zhu},
keywords = {INAR model, INGARCH model, Negative autocorrelation, -valued time series, -valued model},
abstract = {This paper devotes to give a comprehensive review of Z-valued time series models, which allow negative autocorrelations besides positive autocorrelations. Z-valued versions of integer-valued autoregressive (INAR) models are mainly based on three different operators: signed thinning operators, difference operators and rounding operators, while Z-valued versions of integer-valued generalized autoregressive conditional heteroscedastic (INGARCH) models can be classified into four categories: some Z-valued discrete distributions, difference of two independent nonnegative INGARCH models, nonnegative INGARCH models multiplying by some special Z-valued discrete random variables, and random rounding operators. We review stochastic properties, briefly discuss the estimation methods of the Z-valued INAR-type and INGARCH-type models and use two real examples to show their applications. In addition, we also consider some other Z-valued models, including the Bernoulli difference model with taking values −1,0,1, and the discrete ARMA model. Finally, some possible extensions are discussed.}
}


@article{AndersonKarlis2014,
author = {Jonas Andersson and Dimitris Karlis},
title ={A parametric time series model with covariates for integers in Z},
journal = {Statistical Modelling},
volume = {14},
number = {2},
pages = {135-156},
year = {2014},
doi = {10.1177/1471082X13504719},
URL = {https://doi.org/10.1177/1471082X13504719},
eprint = {https://doi.org/10.1177/1471082X13504719},
abstract = { While models for integer valued time series are now abundant, there is a shortage of similar models when the time series refer to data defined on Z, i.e., in both the positive and negative integers. Such data occur in certain disciplines and the need for such models also appear when taking differences of a positive integer count time series. In addition one would often like to include covariates to explain variations in the variable of interest. In this article we construct a model doing all these assuming a specific innovation distribution and provide fully parametric inference, including prediction. Real data applications on accidents and financial returns are given. Finally we also discuss alternative models and extensions. }
}

